from typing import Any, Callable, Optional

__version__: str

class ConfigError(ValueError): ...
class GatewayError(Exception): ...
class GatewayTimeout(GatewayError): ...

class Pending:
    def cancel(self) -> None: ...

class Reply:
    status: int
    headers: list[tuple[str, str]]
    def next_chunk(self, timeout: Optional[float] = None) -> Optional[bytes]: ...
    def next_chunk_async(self, done: Callable[[Any, Any], None], timeout: Optional[float] = None) -> Pending: ...
    def close(self) -> None: ...

class Server:
    url: str
    banner: str
    def stop(self) -> None: ...
    def stop_async(self, done: Callable[[Any, Any], None]) -> Pending: ...
    def wait(self) -> None: ...
    def __enter__(self) -> Server: ...
    def __exit__(self, *exc: Any) -> None: ...

class Native:
    @staticmethod
    def from_toml(text: str) -> Native: ...
    @staticmethod
    def from_json(text: str) -> Native: ...
    @staticmethod
    def from_file(path: str) -> Native: ...
    @staticmethod
    def discover() -> Native: ...
    def send(
        self, method: str, target: str, headers: list[tuple[str, str]], body: bytes, timeout: Optional[float] = None
    ) -> Reply: ...
    def send_async(
        self, method: str, target: str, headers: list[tuple[str, str]], body: bytes,
        done: Callable[[Any, Any], None], timeout: Optional[float] = None,
    ) -> Pending: ...
    def send_admin(
        self, method: str, target: str, headers: list[tuple[str, str]], body: bytes, timeout: Optional[float] = None
    ) -> Reply: ...
    def send_admin_async(
        self, method: str, target: str, headers: list[tuple[str, str]], body: bytes,
        done: Callable[[Any, Any], None], timeout: Optional[float] = None,
    ) -> Pending: ...
    def serve(self, host: str, port: int) -> Server: ...

def run_cli(args: list[str]) -> int: ...
